rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Menu items: public to read for all customers; create, update, delete only for authenticated admin
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Website settings: public to read for all customers; create, update, delete only for authenticated admin
    match /websiteSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: customers can submit orders; authenticated admin can view and update
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
